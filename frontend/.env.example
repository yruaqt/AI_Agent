# The browser always requests the same-origin /api path.
VITE_API_BASE=/api/v1

# Vite forwards /api to this backend during local development.
# Use localhost for your own backend, or another teammate's LAN address.
VITE_PROXY_TARGET=http://localhost:8080

# Change this only when several frontend instances run on one computer.
VITE_DEV_PORT=5173
